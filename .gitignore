# GAS soubory — pushují se přes clasp, NE do GitHub Pages repa
Obedy.html
Obedy-preview.html
obedy.js
obedy.tests.js
Menza.feed.js
Help.html
menza_historie.js
appsscript.json
.clasp.json
.claspignore

# Staré .gs exporty (před clasp setupem) — lokální backup, nepatří do gitu
*.gs

# Prototypy (lokální)
*-preview.html
*-prototyp.html

# Lokální pracovní složky Claude Code / memory — nikdy do gitu.
# .md soubory v projektu (např. JIDLOGIC-DOKUMENTACE.md) se commitují,
# jen soubory uvnitř těchto ignorovaných složek zůstávají lokální.
.auto-memory/
.claude/*
# Projektové skilly (checklisty postupů) se verzují; settings.local.json ne.
!.claude/skills/

# Spreadsheet předlohy
*.xlsx
*.xls

# Office lock soubory
.~lock.*

# Záloha rozbitého .git
.git-corrupted-backup/

# Systémové / IDE
node_modules/
.DS_Store
.vscode/

# jidlogic.menicka/ je samostatný private repo (https://github.com/jurencak-bob/lunchhunter).
# V parent public repu (jidlogic) nesmí být. Klonuje se separátně do téhle složky.
jidlogic.menicka/

# --- Bezpečnost (doplněno) ---
.env
credentials.json
token.json

# script_python: logy běhů a výstupy UI smoke testu (kopie Obedy.html + screenshoty)
script_python/log/
script_python/ui_smoke_out/
__pycache__/
